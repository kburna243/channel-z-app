        android:strokeColor="#33FF6321"
        android:strokeWidth="32"
        android:fillColor="#00000000" />

    <path
        android:pathData="M960,540m-240,0a240,240 0 1,0 480,0a240,240 0 1,0 -480,0"
        android:strokeColor="#4D8A1224"
        android:strokeWidth="40"
        android:fillColor="#00000000" />

    <!-- Center Vignette Glow -->
    <path
        android:pathData="M960,540m-140,0a140,140 0 1,0 280,0a140,140 0 1,0 -280,0"
        android:fillColor="#33E50914" />
</vector>
