        </aapt:attr>
    </path>

    <!-- Radial Vortex Rings -->
    <path
        android:pathData="M960,540m-520,0a520,520 0 1,0 1040,0a520,520 0 1,0 -1040,0"
        android:strokeColor="#26FF3366"
        android:strokeWidth="48"
        android:fillColor="#00000000" />

