    android:viewportHeight="1080">

    <!-- Dark Burgundy / Midnight Background -->
    <path
        android:pathData="M0,0h1920v1080h-1920z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="960"
                android:startY="0"
                android:endX="960"
                android:endY="1080"
                android:type="linear">
                <item android:offset="0.0" android:color="#2B0A12" />
                <item android:offset="0.4" android:color="#140508" />
                <item android:offset="0.7" android:color="#360C16" />
                <item android:offset="1.0" android:color="#0A0204" />
